# Copy this file to .env.development and fill in real values:
#   cp .env.example .env.development
# .env.development is read by both the natively-run API (see config.py) and by
# the infra containers in compose.development.yml (postgres, minio). It is
# gitignored — never commit it.

ENVIRONMENT=development   # development | staging | test | production

# Postgres — consumed by the postgres container (bootstrap) AND by the natively-run
# API (DATABASE_URL uses localhost:5432, the port compose.development.yml publishes;
# see ADR-0009 for why the API isn't containerized in dev).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Cache Redis (ADR-0003)
CACHE_REDIS_URL=redis://localhost:6380/0

# Job Queue Redis (ADR-0002 / ADR-0004)
QUEUE_REDIS_URL=redis://localhost:6381/0

# Rate Limit Redis (ADR-0006 / ADR-0007)
RATELIMIT_REDIS_URL=redis://localhost:6382/0

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET_NAME=culinary-blog
MINIO_SECURE=false

# Observability (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=culinary-blog-api

# CORS
CORS_ORIGINS=http://localhost:3000 # change to an actual domain name in production

# Auth (CONS-004) — generate a real secret for anything outside development,
# e.g. `openssl rand -hex 32`; the app refuses to start without one (see config.py).
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
