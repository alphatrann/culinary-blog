    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Active requests",
      "description": "Requests being served right now (concurrency).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
