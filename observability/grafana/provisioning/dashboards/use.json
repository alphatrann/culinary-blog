      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(5, sum by (name) (container_memory_working_set_bytes{name=~\"culinary-blog-prod-.+\"}) / (sum by (name) (container_spec_memory_limit_bytes{name=~\"culinary-blog-prod-.+\"}) > 0))",
