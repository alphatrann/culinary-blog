      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 18px;border:1px solid #8a9486;border-radius:8px;background:#fafaf6;color:#1f2a22;font:500 14px 'Be Vietnam Pro',system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-outline:hover{background:#eef1e6}.ds-btn-outline:focus-visible{outline:2px solid #2f6b3f;outline-offset:2px}"
