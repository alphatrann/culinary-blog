    },
    {
      "name": "Recipe Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Signature recipe tile with tinted placeholder.",
      "html": "<div class=\"ds-card\"><div class=\"ds-card-img\"><span class=\"ds-card-badge\">Món nước</span></div><div class=\"ds-card-body\"><h3>Phở bò</h3><p>2 giờ · Trung bình</p><p>Bởi An</p></div></div>",
      "css": ".ds-card{width:280px;overflow:hidden;border:1px solid #dfe3d8;border-radius:12px;background:#fff;box-shadow:0 1px 2px rgb(0 0 0/.05);transition:box-shadow .15s;font:400 14px 'Be Vietnam Pro',system-ui,sans-serif;color:#55615a}.ds-card:hover{box-shadow:0 4px 12px rgb(0 0 0/.08)}.ds-card-img{position:relative;aspect-ratio:4/3;background:#e9d8b8;border-bottom:1px solid #dfe3d8}.ds-card-badge{position:absolute;top:12px;left:12px;height:24px;padding:0 10px;display:inline-flex;align-items:center;border:1px solid #dfe3d8;border-radius:999px;background:#fafaf6;color:#1f2a22;font-weight:600;font-size:12px}.ds-card-body{padding:16px}.ds-card-body h3{margin:0 0 8px;font:600 20px/1.25 Fraunces,Georgia,serif;color:#1f2a22}.ds-card-body p{margin:4px 0 0}"
    },
    {
      "name": "Ingredient Row",
      "kind": "custom",
      "description": "Checkable ingredient line on the recipe detail page; 44px target, quantity right-aligned, checked items struck through.",
      "html": "<label class=\"ds-ing\"><span class=\"ds-ing-box\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12l5 5 9-10\"/></svg></span><span class=\"ds-ing-n\">Xương ống bò</span><span class=\"ds-ing-q\">1,5 kg</span></label>",
      "css": ".ds-ing{display:flex;align-items:center;gap:12px;min-height:44px;padding:8px 0;border-bottom:1px solid #dfe3d8;font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:14px;color:#1f2a22;cursor:pointer}.ds-ing-box{display:grid;place-content:center;flex:none;width:16px;height:16px;border:1px solid #2f6b3f;border-radius:4px;background:#2f6b3f}.ds-ing-n{flex:1;min-width:0}.ds-ing-q{color:#55615a;text-align:right}.ds-ing:hover .ds-ing-n{color:#000}.ds-ing:focus-within .ds-ing-box{outline:2px solid #2f6b3f;outline-offset:2px}"
    },
    {
      "name": "Recipe Step",
      "kind": "custom",
      "description": "Numbered method step: herb-green number disc, serif step title, comfortable body measure.",
      "html": "<div class=\"ds-step\"><span class=\"ds-step-n\">1</span><div><h3 class=\"ds-step-t\">Làm sạch xương</h3><p class=\"ds-step-p\">Chần xương ống với nước sôi 5 phút, rửa sạch bọt bẩn.</p></div></div>",
      "css": ".ds-step{display:flex;gap:16px}.ds-step-n{flex:none;display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:999px;background:#2f6b3f;color:#fff;font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:14px;font-weight:600}.ds-step-t{margin:2px 0 6px;font-family:Fraunces,Georgia,serif;font-size:20px;line-height:1.25;font-weight:600;color:#1f2a22}.ds-step-p{margin:0;max-width:70ch;font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:14px;line-height:1.75;color:#1f2a22}"
    },
    {
      "name": "Meta Strip",
      "kind": "custom",
      "description": "Hairline-divided stat cells (prep, cook, servings, difficulty) under the recipe gallery.",
      "html": "<dl class=\"ds-meta\"><div class=\"ds-meta-i\"><dt>Chuẩn bị</dt><dd>30 phút</dd></div><div class=\"ds-meta-i\"><dt>Nấu</dt><dd>3 giờ</dd></div></dl>",
      "css": ".ds-meta{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;margin:0;overflow:hidden;border:1px solid #dfe3d8;border-radius:12px;background:#dfe3d8;box-shadow:0 1px 2px rgb(0 0 0 / .05)}.ds-meta-i{padding:16px 24px;background:#fff}.ds-meta dt{font-family:'Be Vietnam Pro',system-ui,sans-serif;font-size:14px;color:#55615a}.ds-meta dd{margin:4px 0 0;font-family:Fraunces,Georgia,serif;font-size:20px;font-weight:600;color:#1f2a22}"
    },
    {
      "name": "Nutrition Cell",
