      "html": "<button class=\"ds-btn-primary\">Lưu công thức</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 18px;border:1px solid transparent;border-radius:8px;background:#b82a17;color:#fff;font:500 14px 'Be Vietnam Pro',system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:#9a2212}.ds-btn-primary:focus-visible{outline:2px solid #2f6b3f;outline-offset:2px}"
    },
