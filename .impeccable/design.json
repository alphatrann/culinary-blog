      "css": ".ds-btn-herb{display:inline-flex;align-items:center;justify-content:center;height:44px;padding:0 18px;border:1px solid transparent;border-radius:8px;background:#2f6b3f;color:#fff;font:500 14px 'Be Vietnam Pro',system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-herb:hover{background:#255735}.ds-btn-herb:focus-visible{outline:2px solid #2f6b3f;outline-offset:2px}"
