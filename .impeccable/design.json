      "css": ".ds-nut{margin:0;padding:16px 20px;border:1px solid #dfe3d8;border-radius:12px;background:#fff;box-shadow:0 1px 2px rgb(0 0 0 / .05);font-family:'Be Vietnam Pro',system-ui,sans-serif}.ds-nut dt{font-size:14px;color:#55615a}.ds-nut dd{margin:4px 0 0;font-size:24px;font-weight:600;font-variant-numeric:tabular-nums;color:#1f2a22}"
    },
    {
      "name": "Category Chip",
      "kind": "chip",
      "refersTo": "button-outline",
      "description": "44px category filter link on the home page; herb-green fill marks the current one.",
      "html": "<a class=\"ds-chip is-on\" href=\"#\">Tất cả</a> <a class=\"ds-chip\" href=\"#\">Món nước</a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;height:44px;padding:0 16px;border:1px solid #8a9486;border-radius:8px;background:#fafaf6;color:#1f2a22;font:500 14px 'Be Vietnam Pro',system-ui,sans-serif;text-decoration:none;white-space:nowrap}.ds-chip:hover{background:#eef1e6}.ds-chip.is-on{background:#2f6b3f;border-color:#2f6b3f;color:#fff}.ds-chip:focus-visible{outline:2px solid #2f6b3f;outline-offset:2px}"
    },
    {
      "name": "Featured Recipe",
      "kind": "card",
      "refersTo": "card",
      "description": "Home hero card for the newest recipe: 16:10 image or tint, 'Món nổi bật' badge, serif title that turns red on hover.",
      "html": "<a class=\"ds-feat\" href=\"#\"><div class=\"ds-feat-img\"></div><div class=\"ds-feat-body\"><span class=\"ds-feat-k\">Món nổi bật</span><span class=\"ds-feat-t\">Phở bò Hà Nội</span><span class=\"ds-feat-d\">Nước dùng trong, ngọt thanh từ xương bò ninh chậm.</span></div></a>",
      "css": ".ds-feat{display:block;width:420px;overflow:hidden;border:1px solid #dfe3d8;border-radius:12px;background:#fff;box-shadow:0 1px 2px rgb(0 0 0/.05);color:#1f2a22;text-decoration:none;transition:box-shadow .15s}.ds-feat:hover{box-shadow:0 4px 12px rgb(0 0 0/.08)}.ds-feat:hover .ds-feat-t{color:#b82a17}.ds-feat-img{aspect-ratio:16/10;background:#c9dcd5}.ds-feat-body{padding:20px;border-top:1px solid #dfe3d8}.ds-feat-k{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:999px;background:#e6f0e4;color:#2f6b3f;font:600 12px 'Be Vietnam Pro',system-ui,sans-serif}.ds-feat-t{display:block;margin:10px 0 4px;font:600 24px Fraunces,Georgia,serif}.ds-feat-d{display:block;font:400 14px/1.5 'Be Vietnam Pro',system-ui,sans-serif;color:#55615a}"
    }
  ],
  "narrative": {
    "northStar": "The Family Recipe Card",
    "overview": "A well-loved printed recipe card, translated to screen: warm paper underneath, a serif title that feels written rather than set, calm structure, and a single tomato-red action. The food and its tinted placeholders supply the colour; the interface stays quiet so a cook can scan, choose and start cooking.\n\nThe mood is warm, calm and practical. Surfaces are flat and separated by hairlines, copy is Vietnamese with full diacritics, and nothing competes with the recipe. It rejects glossy food-magazine drama and loud app chrome.",
    "keyCharacteristics": [
      "Paper-toned background (#fafaf6) with white cards and 1px sage hairlines.",
      "Serif headings (Fraunces) over a humanist sans (Be Vietnam Pro) for UI and body text.",
      "One tomato-red primary action per view; herb green for brand, links, focus and secondary emphasis.",
      "Light theme only; no dark mode.",
      "44px minimum touch targets on controls."
    ],
    "rules": [
      {
