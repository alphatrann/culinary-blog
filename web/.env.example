# Server components / route handlers call the API directly over the compose network.
API_BASE_URL=http://localhost:8000
# Browser calls go through the same origin (nginx routes /api/ to the API), so cookies stay same-origin.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# FR-AUTH-003: Google OAuth client ID for the "Sign in with Google" button. Unset hides the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
